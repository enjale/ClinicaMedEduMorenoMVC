@model ClinicaMedEduardoMorenoMVCWeb.Models.ExpedienteAlergias

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Agregar Alergia";
	ViewData["Seccion"] = "Expedientes Clínicos";
	var expedienteId = ViewBag.ExpedienteIdActual as int?;
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 class="seccion-h4 mb-1">Agregar Alergia al Expediente</h4>
		@if (expedienteId.HasValue)
		{
			<a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "alergias" })"
			   class="text-muted small">
				← Volver al expediente
			</a>
		}
	</div>
</div>

<hr class="mb-4" />

<div class="row">
	<div class="col-md-6">
		<div class="seccion-card">
			<form asp-action="Create" method="post">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

				<div class="form-group mb-3">
					<label class="form-label">Expediente</label>
					<select asp-for="ExpedienteId" class="form-select" asp-items="ViewBag.ExpedienteId">
						<option value="">-- Seleccione un expediente --</option>
					</select>
					<span asp-validation-for="ExpedienteId" class="text-danger small"></span>
				</div>

				<div class="form-group mb-3">
					<label asp-for="AlergiaId" class="form-label">Alergia</label>
					<select asp-for="AlergiaId" class="form-select" asp-items="ViewBag.AlergiaId">
						<option value="">-- Seleccione una alergia --</option>
					</select>
					<span asp-validation-for="AlergiaId" class="text-danger small"></span>
				</div>

				<div class="form-group mb-3">
					<label asp-for="Nivel" class="form-label">Nivel de Severidad</label>
					<select asp-for="Nivel" class="form-select">
						<option value="">-- Seleccione el nivel --</option>
						<option value="Leve">Leve</option>
						<option value="Moderado">Moderado</option>
						<option value="Severo">Severo</option>
						<option value="Muy Severo">Muy Severo</option>
					</select>
					<span asp-validation-for="Nivel" class="text-danger small"></span>
				</div>

				<div class="form-group mb-4">
					<label asp-for="Observaciones" class="form-label">Observaciones (opcional)</label>
					<textarea asp-for="Observaciones" class="form-control" rows="3"
							  placeholder="Describa las reacciones o síntomas observados..."></textarea>
					<span asp-validation-for="Observaciones" class="text-danger small"></span>
				</div>

				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-clinica">Guardar Alergia</button>
					@if (expedienteId.HasValue)
					{
						<a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "alergias" })"
						   class="btn btn-outline-secondary">
							Cancelar
						</a>
					}
					else
					{
						<a asp-action="Index" class="btn btn-outline-secondary">
							Cancelar
						</a>
					}
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
