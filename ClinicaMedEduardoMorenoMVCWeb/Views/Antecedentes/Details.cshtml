@model ClinicaMedEduardoMorenoMVCWeb.Models.Antecedentes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Detalle de Antecedente";
	ViewData["Seccion"] = "Expedientes Clínicos";
}

<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 class="seccion-h4 mb-1">Detalle de Antecedente Médico</h4>
		@if (Model.ExpedienteId.HasValue)
		{
			<a href="@Url.Action("Details", "Expedientes", new { id = Model.ExpedienteId, tab = "antecedentes" })"
			   class="text-muted small">
				← Volver al expediente
			</a>
		}
		else
		{
			<a asp-action="Index" class="text-muted small">← Volver al listado</a>
		}
	</div>
</div>

<hr class="mb-4" />

<div class="row">
	<div class="col-md-6">
		<div class="seccion-card">
			<h5 class="seccion-titulo">Información del Antecedente</h5>
			<dl class="row mb-0">
				<dt class="col-sm-4 campo-label">Código</dt>
				<dd class="col-sm-8 fw-semibold" style="color:#4F6F52;">ANT-@Model.AntecedentesId.ToString("D3")</dd>

				<dt class="col-sm-4 campo-label">Tipo</dt>
				<dd class="col-sm-8">@Model.Tipo</dd>

				<dt class="col-sm-4 campo-label">Descripción</dt>
				<dd class="col-sm-8">@Model.Descripcion</dd>

				<dt class="col-sm-4 campo-label">Fecha</dt>
				<dd class="col-sm-8">@(Model.Fecha?.ToString("dd/MM/yyyy") ?? "—")</dd>
			</dl>
		</div>

		<div class="d-flex gap-2 mt-3">
			<a asp-action="Edit" asp-route-id="@Model.AntecedentesId" class="btn btn-clinica">
				Editar
			</a>
			@if (Model.ExpedienteId.HasValue)
			{
				<a href="@Url.Action("Details", "Expedientes", new { id = Model.ExpedienteId, tab = "antecedentes" })"
				   class="btn btn-outline-secondary">
					Volver al Expediente
				</a>
			}
			else
			{
				<a asp-action="Index" class="btn btn-outline-secondary">
					Volver al Listado
				</a>
			}
		</div>
	</div>
</div>
