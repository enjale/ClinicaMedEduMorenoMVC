@using Microsoft.AspNetCore.Http
@{
    var rolSesion = Context.Session.GetString("UsuarioRol");
    var esEnfermera = (!string.IsNullOrEmpty(rolSesion) && rolSesion.Equals("Enfermera", StringComparison.OrdinalIgnoreCase))
                      || User.IsInRole("Enfermera")
                      || (ViewBag.EsEnfermera is bool b && b);
    var nombreUsuario = Context.Session.GetString("UsuarioNombre")
                        ?? User.Identity?.Name
                        ?? (esEnfermera ? "Enfermera" : "Dr. Eduardo Moreno");
    var rolTexto = esEnfermera ? "Enfermera" : "Doctor";

    // Iniciales para el avatar del menú de usuario (sin prefijos como "Dr." o "Enf.")
    var iniciales = string.Concat(nombreUsuario
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Where(p => !p.EndsWith("."))
        .Take(2)
        .Select(p => char.ToUpper(p[0])));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clínica Médica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex min-vh-100">

    <!--Barra Lateral Izquierda-->
    <aside class="sidebar-clinica d-flex flex-column">

        <!--Logo Clinica-->
        <a asp-controller="Expedientes" asp-action="Index" class="text-decoration-none text-white">
            <div class="sidebar-header">
                <small>CLINICA MEDICA</small>
                <h3>Eduardo Moreno</h3>
            </div>
        </a>

        <!--Menu Barras Laterales-->
        <nav class="sidebar-menu flex-grow-1">
            <a asp-controller="Expedientes" asp-action="Index">Expedientes Clinicos</a>
            <a asp-controller="Consultas" asp-action="Index">Consultas Medicas</a>

            @if (!esEnfermera)
            {
                <div class="sidebar-section">CATALOGOS</div>
                <a asp-controller="Medicamentos" asp-action="Index">Medicamentos</a>
                <a asp-controller="Alergias" asp-action="Index">Alergias</a>
                <a asp-controller="Enfermedades" asp-action="Index">Enfermedades</a>
            }
        </nav>
    </aside>

    <!--Contenido de derecha-->
    <main class="contenido-principal flex-grow-1">

        <!--Barra Superior Verde con Datos Del Usuario Activo-->
        <header class="header-doctor d-flex justify-content-between align-items-center">
            <span class="fw-bold">@(ViewData["Seccion"] ?? ViewData["Title"] ?? "Panel Principal")</span>

            <!-- Menú de usuario con la opción de cerrar sesión -->
            <div class="dropdown">
                <button type="button" class="usuario-menu-boton dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="usuario-avatar">@iniciales</span>
                    <span class="text-start lh-sm">
                        <span class="d-block usuario-nombre">@nombreUsuario</span>
                        <span class="d-block usuario-rol">@rolTexto</span>
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm usuario-menu">
                    <li class="px-3 py-2">
                        <div class="fw-semibold">@nombreUsuario</div>
                        <div class="small text-muted">@rolTexto</div>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item usuario-menu-salir" asp-controller="Account" asp-action="Logout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                            </svg>
                            Cerrar sesión
                        </a>
                    </li>
                </ul>
            </div>
        </header>

        <!-- Contenido de la vista -->
        <div class="p-4">
            @RenderBody()
        </div>

    </main>

    <!-- Modal de confirmación reutilizable (se abre con data-confirmar="mensaje" en un formulario o botón) -->
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-confirmar">
                <div class="modal-body text-center px-4 pt-4 pb-3">
                    <div class="modal-confirmar-icono mx-auto mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                        </svg>
                    </div>
                    <h5 class="modal-confirmar-titulo mb-2" id="modalConfirmarTitulo">Confirmar eliminación</h5>
                    <p class="modal-confirmar-mensaje mb-0" id="modalConfirmarMensaje"></p>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0 pb-4 gap-2">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger px-4" id="modalConfirmarAceptar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
