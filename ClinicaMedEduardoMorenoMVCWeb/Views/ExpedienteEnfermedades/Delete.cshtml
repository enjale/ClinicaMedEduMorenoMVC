@model ClinicaMedEduardoMorenoMVCWeb.Models.ExpedienteEnfermedades

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Eliminar Enfermedad";
    ViewData["Seccion"] = "Expedientes Clínicos";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="seccion-h4 mb-1">Eliminar Enfermedad del Expediente</h4>
        <a asp-action="Index" class="text-muted small">← Volver a la lista</a>
    </div>
</div>

<hr class="mb-4" />

<div class="alert alert-danger" role="alert" style="max-width: 600px;">
    ¿Está seguro que desea eliminar este registro? Esta acción no se puede deshacer.
</div>

<div class="row">
    <div class="col-md-6">
        <div class="seccion-card">
            <dl class="row mb-0">
                <dt class="col-sm-4 campo-label">Expediente</dt>
                <dd class="col-sm-8">@(Model.Expediente?.Codigo ?? Model.ExpedienteId.ToString())</dd>

                <dt class="col-sm-4 campo-label">Enfermedad</dt>
                <dd class="col-sm-8 fw-semibold">@(Model.Enfermedad?.Nombre ?? Model.EnfermedadId.ToString())</dd>

                <dt class="col-sm-4 campo-label">Fecha Detección</dt>
                <dd class="col-sm-8">@(Model.FechaDeteccion?.ToString("dd/MM/yyyy") ?? "—")</dd>

                <dt class="col-sm-4 campo-label">Observaciones</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Observaciones) ? "—" : Model.Observaciones)</dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ExpedienteEnfermedadId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-peligro">Confirmar Eliminación</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
