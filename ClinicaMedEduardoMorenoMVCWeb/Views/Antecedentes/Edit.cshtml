@model ClinicaMedEduardoMorenoMVCWeb.Models.Antecedentes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Editar Antecedente";
	ViewData["Seccion"] = "Expedientes Clínicos";
	var expedienteId = Model.ExpedienteId;
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 class="seccion-h4 mb-1">Editar Antecedente Médico</h4>
		@if (expedienteId.HasValue)
		{
			<a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "antecedentes" })"
			   class="text-muted small">
				← Volver al expediente
			</a>
		}
	</div>
</div>

<hr class="mb-4" />

<div class="row">
	<div class="col-md-6">
		<div class="seccion-card">
			<form asp-action="Edit" method="post">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

				<!-- Campos ocultos -->
				<input type="hidden" asp-for="AntecedentesId" />
				<input type="hidden" asp-for="ExpedienteId" />

				<div class="form-group mb-3">
					<label asp-for="Tipo" class="form-label">Tipo de Antecedente</label>
					<select asp-for="Tipo" class="form-select">
						<option value="">-- Seleccione un tipo --</option>
						<option value="Familiar">Familiar</option>
						<option value="Personal">Personal</option>
						<option value="Quirúrgico">Quirúrgico</option>
						<option value="Alérgico">Alérgico</option>
						<option value="Patológico">Patológico</option>
						<option value="Farmacológico">Farmacológico</option>
						<option value="Traumático">Traumático</option>
						<option value="Gineco-Obstétrico">Gineco-Obstétrico</option>
						<option value="Otro">Otro</option>
					</select>
					<span asp-validation-for="Tipo" class="text-danger small"></span>
				</div>

				<div class="form-group mb-3">
					<label asp-for="Descripcion" class="form-label">Descripción</label>
					<textarea asp-for="Descripcion" class="form-control" rows="4"
							  placeholder="Describa el antecedente médico..."></textarea>
					<span asp-validation-for="Descripcion" class="text-danger small"></span>
				</div>

				<div class="form-group mb-4">
					<label asp-for="Fecha" class="form-label">Fecha *</label>
					<input asp-for="Fecha" type="date" class="form-control" required />
					<span asp-validation-for="Fecha" class="text-danger small"></span>
				</div>

				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-clinica">Guardar Cambios</button>
					@if (expedienteId.HasValue)
					{
						<a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "antecedentes" })"
						   class="btn btn-outline-secondary">
							Cancelar
						</a>
					}
					else
					{
						<a asp-action="Index" class="btn btn-outline-secondary">
							Cancelar
						</a>
					}
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
