@model IEnumerable<ClinicaMedEduardoMorenoMVCWeb.Models.RecetaDetalle>

@{
	ViewData["Title"] = "Detalles de recetas";
}

<h1>Detalles de recta</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
</p>

<table class="table table-striped">
	<thead>
		<tr>
			<th>@Html.DisplayNameFor(model => model.RecetaId)</th>
			<th>@Html.DisplayNameFor(model => model.MedicamentoId)</th>
			<th>@Html.DisplayNameFor(model => model.Orden)</th>
			<th>@Html.DisplayNameFor(model => model.Prescripcion)</th>
			<th>@Html.DisplayNameFor(model => model.Cantidad)</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var item in Model)
		{
			<tr>
				<td>@Html.DisplayFor(modelItem => item.RecetaId)</td>
				<td>@Html.DisplayFor(modelItem => item.MedicamentoId)</td>
				<td>@Html.DisplayFor(modelItem => item.Orden)</td>
				<td>@Html.DisplayFor(modelItem => item.Prescripcion)</td>
				<td>@Html.DisplayFor(modelItem => item.Cantidad)</td>
				<td>
					<a asp-action="Details" asp-route-id="@item.RecetaDetalleId" class="btn btn-sm btn-outline-secondary">Detalles</a>
					<a asp-action="Edit" asp-route-id="@item.RecetaDetalleId" class="btn btn-sm btn-outline-primary">Editar</a>
					<a asp-action="Delete" asp-route-id="@item.RecetaDetalleId" class="btn btn-sm btn-outline-danger">Eliminar</a>
				</td>
			</tr>
		}
	</tbody>

</table>
