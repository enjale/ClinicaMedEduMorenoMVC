@model ClinicaMedEduardoMorenoMVCWeb.Models.Recetas

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Eliminar Receta";
    ViewData["Seccion"] = "Recetas";
}

<div class="mb-3">
    <h1>Eliminar Receta</h1>
    <a asp-action="Index" class="text-muted small">← Volver a la lista</a>
</div>

<hr />
<div class="alert alert-danger" role="alert">
    ¿Está seguro que desea eliminar esta receta? Esta acción no se puede deshacer.
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Codigo)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Codigo)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ConsultaId)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.ConsultaId)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Fecha)</dt>
            <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Medico)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Medico)</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="RecetaId" />
            <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
