@model ClinicaMedEduardoMorenoMVCWeb.Models.ViewModels.ResetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Restablecer Contraseña - Clínica Médica";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <!-- Panel Lateral Izquierdo -->
        <div class="login-lateral">
            <div class="login-subtitulo-clinica">CLÍNICA MÉDICA</div>
            <div class="login-nombre-clinica">Eduardo Moreno</div>
            <div class="login-linea-divisoria"></div>
            <p class="login-descripcion-sistema">Sistema de Gestión de Expedientes Médicos</p>
        </div>

        <!-- Panel Central/Derecho con Tarjeta -->
        <div class="login-derecho">
            <div class="login-tarjeta">
                <h2 class="login-titulo-formulario" style="font-size: 1.4rem; margin-bottom: 0.5rem;">Nueva Contraseña</h2>
                <p class="text-muted small text-center mb-4">
                    Ingrese su nueva contraseña para la cuenta <strong>@Model.Email</strong>
                </p>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="login-form-group">
                        <label asp-for="NewPassword" class="login-label">Nueva Contraseña</label>
                        <input asp-for="NewPassword" type="password" class="login-input" placeholder="Mínimo 6 caracteres" autofocus />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="login-form-group">
                        <label asp-for="ConfirmPassword" class="login-label">Confirmar Contraseña</label>
                        <input asp-for="ConfirmPassword" type="password" class="login-input" placeholder="Repita la nueva contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="login-boton-submit">
                        Guardar y Cambiar Contraseña
                    </button>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="login-enlace-olvide" style="text-align: center; display: inline-block;">
                            ← Cancelar y Volver al Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
