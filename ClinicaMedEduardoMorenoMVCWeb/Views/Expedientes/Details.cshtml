@model ClinicaMedEduardoMorenoMVCWeb.Models.ViewModels.ExpedienteDetalleViewModel

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Expediente Clínico";
	ViewData["Seccion"] = "Expedientes Clínicos";
	var tab = Model.TabActiva;
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 style="font-weight:700; color:#2F3E34; margin-bottom:0.15rem;">
			Expediente Clínico · @(Model.Paciente?.Nombre ?? "Paciente desconocido")
		</h4>
		<span class="text-muted small">
			Código: <strong style="color:#4F6F52;">@Model.Expediente.Codigo</strong> &nbsp;|&nbsp; Fecha Creación: <strong>@Model.Expediente.FechaCreacion.ToString("dd/MM/yyyy")</strong>
		</span>
	</div>
	<div class="d-flex gap-2">
		<a asp-action="Edit" asp-route-id="@Model.Expediente.ExpedienteId" class="btn btn-sm btn-clinica">Editar Expediente</a>
		<a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
	</div>
</div>

<hr style="margin: 0 0 1.5rem 0;" />

<!-- Tabs de navegación -->
<ul class="nav border-bottom mb-4">
	<li class="nav-item">
		<a href="@Url.Action("Details", "Expedientes", new { id = Model.Expediente.ExpedienteId, tab = "datos" })"
		   class="tab-link @(tab=="datos" ? "tab-activo" : "")">
			Datos del Paciente
		</a>
	</li>
	<li class="nav-item">
		<a href="@Url.Action("Details", "Expedientes", new { id = Model.Expediente.ExpedienteId, tab = "alergias" })"
		   class="tab-link @(tab=="alergias" ? "tab-activo" : "")">
			Alergias y Enfermedades
		</a>
	</li>
	<li class="nav-item">
		<a href="@Url.Action("Details", "Expedientes", new { id = Model.Expediente.ExpedienteId, tab = "antecedentes" })"
		   class="tab-link @(tab=="antecedentes" ? "tab-activo" : "")">
			Antecedentes
		</a>
	</li>
	<li class="nav-item">
		<a href="@Url.Action("Details", "Expedientes", new { id = Model.Expediente.ExpedienteId, tab = "consultas" })"
		   class="tab-link @(tab=="consultas" ? "tab-activo" : "")">
			Consultas
		</a>
	</li>
</ul>

<!-- ───── TAB: DATOS DEL PACIENTE ───── -->
@if (tab == "datos")
{
	// Edad calculada a la fecha actual a partir de la fecha de nacimiento
	int? edad = null;
	if (Model.Paciente?.FechaNac is DateTime fechaNac)
	{
		edad = DateTime.Today.Year - fechaNac.Year;
		if (fechaNac.Date > DateTime.Today.AddYears(-edad.Value)) edad--;
	}

	<div class="row g-4">
		<div class="col-md-6">
			<div class="seccion-card h-100">
				<h5 class="seccion-titulo">Información Personal</h5>
				<dl class="row mb-0">
					<dt class="col-sm-5 campo-label">Nombre completo</dt>
					<dd class="col-sm-7 fw-semibold">@(Model.Paciente?.Nombre ?? "—")</dd>

					<dt class="col-sm-5 campo-label">Sexo</dt>
					<dd class="col-sm-7">
						@if (Model.Paciente?.Sexo == "M")
						{
							<span class="badge bg-light text-dark border">Masculino</span>
						}
						else if (Model.Paciente?.Sexo == "F")
						{
							<span class="badge bg-light text-dark border">Femenino</span>
						}
						else
						{
							<span>@(Model.Paciente?.Sexo ?? "—")</span>
						}
					</dd>

					<dt class="col-sm-5 campo-label">Fecha de nacimiento</dt>
					<dd class="col-sm-7">@(Model.Paciente?.FechaNac?.ToString("dd/MM/yyyy") ?? "—")</dd>

					<dt class="col-sm-5 campo-label">Edad</dt>
					<dd class="col-sm-7">@(edad.HasValue ? $"{edad} años" : "—")</dd>

					<dt class="col-sm-5 campo-label">DUI</dt>
					<dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Paciente?.DUI) ? "—" : Model.Paciente.DUI)</dd>

					<dt class="col-sm-5 campo-label">Teléfono</dt>
					<dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Paciente?.Telefono) ? "—" : Model.Paciente.Telefono)</dd>

					<dt class="col-sm-5 campo-label">Dirección</dt>
					<dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Paciente?.Direccion) ? "—" : Model.Paciente.Direccion)</dd>
				</dl>
			</div>
		</div>
		<div class="col-md-6">
			<div class="seccion-card h-100">
				<h5 class="seccion-titulo">Medidas y Expediente</h5>
				<dl class="row mb-0">
					<dt class="col-sm-5 campo-label">Altura</dt>
					<dd class="col-sm-7">@(Model.Paciente?.Altura.HasValue == true ? $"{Model.Paciente.Altura:0.00} m" : "—")</dd>

					<dt class="col-sm-5 campo-label">Peso</dt>
					<dd class="col-sm-7">@(Model.Paciente?.Peso.HasValue == true ? $"{Model.Paciente.Peso:0.00} kg" : "—")</dd>

					<dt class="col-sm-5 campo-label">Código expediente</dt>
					<dd class="col-sm-7" style="color:#4F6F52; font-weight:600;">@Model.Expediente.Codigo</dd>

					<dt class="col-sm-5 campo-label">Fecha creación</dt>
					<dd class="col-sm-7">@Model.Expediente.FechaCreacion.ToString("dd/MM/yyyy")</dd>
				</dl>
			</div>
		</div>
	</div>
}

<!-- ───── TAB: ALERGIAS Y ENFERMEDADES ───── -->
@if (tab == "alergias")
{
	<!-- SECCIÓN ALERGIAS -->
	<div class="mb-4">
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h4 class="seccion-h4">Alergias</h4>
			<a asp-controller="ExpedienteAlergias" asp-action="Create"
			   asp-route-expedienteId="@Model.Expediente.ExpedienteId"
			   class="btn btn-sm btn-clinica">
				+ Agregar Alergia
			</a>
		</div>

		<div class="tabla-wrap">
			<table class="tabla-interna">
				<thead>
					<tr>
						<th>Alergia</th>
						<th>Nivel</th>
						<th>Observaciones</th>
						<th class="text-end">Acciones</th>
					</tr>
				</thead>
				<tbody>
					@if (!Model.Alergias.Any())
					{
						<tr><td colspan="4" class="tabla-vacia">No hay alergias registradas.</td></tr>
					}
					@foreach (var a in Model.Alergias)
					{
						<tr>
							<td style="font-weight:600;">@(a.Alergia?.Nombre ?? a.AlergiaId.ToString())</td>
							<td><span class="badge bg-light text-dark border">@a.Nivel</span></td>
							<td>@(string.IsNullOrEmpty(a.Observaciones) ? "—" : a.Observaciones)</td>
							<td class="text-end">
								<form asp-controller="ExpedienteAlergias" asp-action="DeleteFromExpediente" method="post" class="d-inline">
									@Html.AntiForgeryToken()
									<input type="hidden" name="id" value="@a.ExpedienteAlergiaId" />
									<input type="hidden" name="expedienteId" value="@Model.Expediente.ExpedienteId" />
									<button type="submit" class="btn btn-sm btn-peligro"
											onclick="return confirm('¿Eliminar esta alergia?')">
										Eliminar
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- SECCIÓN ENFERMEDADES CRÓNICAS -->
	<div>
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h4 class="seccion-h4">Enfermedades Crónicas</h4>
			<a asp-controller="ExpedienteEnfermedades" asp-action="Create"
			   asp-route-expedienteId="@Model.Expediente.ExpedienteId"
			   class="btn btn-sm btn-clinica">
				+ Agregar Enfermedad
			</a>
		</div>

		<div class="tabla-wrap">
			<table class="tabla-interna">
				<thead>
					<tr>
						<th>Enfermedad</th>
						<th>Tipo</th>
						<th>Fecha Detección</th>
						<th>Observaciones</th>
						<th class="text-end">Acciones</th>
					</tr>
				</thead>
				<tbody>
					@if (!Model.Enfermedades.Any())
					{
						<tr><td colspan="5" class="tabla-vacia">No hay enfermedades registradas.</td></tr>
					}
					@foreach (var e in Model.Enfermedades)
					{
						<tr>
							<td style="font-weight:600;">@(e.Enfermedad?.Nombre ?? e.EnfermedadId.ToString())</td>
							<td><span class="badge bg-light text-dark border">@(e.Enfermedad?.TipoEnfermedad ?? "—")</span></td>
							<td>@(e.FechaDeteccion?.ToString("dd/MM/yyyy") ?? "—")</td>
							<td>@(string.IsNullOrEmpty(e.Observaciones) ? "—" : e.Observaciones)</td>
							<td class="text-end">
								<form asp-controller="ExpedienteEnfermedades" asp-action="DeleteFromExpediente" method="post" class="d-inline">
									@Html.AntiForgeryToken()
									<input type="hidden" name="id" value="@e.ExpedienteEnfermedadId" />
									<input type="hidden" name="expedienteId" value="@Model.Expediente.ExpedienteId" />
									<button type="submit" class="btn btn-sm btn-peligro"
											onclick="return confirm('¿Eliminar esta enfermedad?')">
										Eliminar
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

<!-- ───── TAB: ANTECEDENTES ───── -->
@if (tab == "antecedentes")
{
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h4 class="seccion-h4">Antecedentes Médicos</h4>
		<a asp-controller="Antecedentes" asp-action="Create"
		   asp-route-expedienteId="@Model.Expediente.ExpedienteId"
		   class="btn btn-sm btn-clinica">
			+ Agregar Antecedente
		</a>
	</div>

	<div class="tabla-wrap">
		<table class="tabla-interna">
			<thead>
				<tr>
					<th>Código</th>
					<th>Tipo</th>
					<th>Descripción</th>
					<th>Fecha</th>
					<th>Observaciones</th>
					<th class="text-end">Acciones</th>
				</tr>
			</thead>
			<tbody>
				@if (!Model.Antecedentes.Any())
				{
					<tr><td colspan="6" class="tabla-vacia">No hay antecedentes registrados.</td></tr>
				}
				@foreach (var ant in Model.Antecedentes)
				{
					<tr>
						<td style="color:#4F6F52; font-weight:600;">@(string.IsNullOrEmpty(ant.Codigo) ? $"ANT-{ant.AntecedentesId:D3}" : ant.Codigo)</td>
						<td><span class="badge bg-light text-dark border">@ant.Tipo</span></td>
						<td>@ant.Descripcion</td>
						<td>@(ant.Fecha?.ToString("dd/MM/yyyy") ?? "—")</td>
						<td>@(string.IsNullOrEmpty(ant.Observaciones) ? "—" : ant.Observaciones)</td>
						<td class="text-end">
							<a asp-controller="Antecedentes" asp-action="Edit" asp-route-id="@ant.AntecedentesId"
							   class="btn btn-sm btn-clinica me-1">
								Editar
							</a>
							<form asp-controller="Antecedentes" asp-action="DeleteFromExpediente" method="post" class="d-inline">
								@Html.AntiForgeryToken()
								<input type="hidden" name="id" value="@ant.AntecedentesId" />
								<input type="hidden" name="expedienteId" value="@Model.Expediente.ExpedienteId" />
								<button type="submit" class="btn btn-sm btn-peligro"
										onclick="return confirm('¿Eliminar este antecedente?')">
									Eliminar
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

<!-- ───── TAB: CONSULTAS ───── -->
@if (tab == "consultas")
{
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h4 class="seccion-h4">Consultas Médicas</h4>
		<a asp-controller="Consultas" asp-action="Create"
		   asp-route-expedienteId="@Model.Expediente.ExpedienteId"
		   class="btn btn-sm btn-clinica">
			+ Nueva Consulta
		</a>
	</div>

	<div class="tabla-wrap">
		<table class="tabla-interna">
			<thead>
				<tr>
					<th>Código</th>
					<th>Fecha</th>
					<th>Motivo</th>
					<th>Médico</th>
					<th>Diagnóstico</th>
					<th>Estado</th>
					<th class="text-end">Acciones</th>
				</tr>
			</thead>
			<tbody>
				@if (!Model.Consultas.Any())
				{
					<tr><td colspan="7" class="tabla-vacia">No hay consultas registradas para este expediente.</td></tr>
				}
				@foreach (var c in Model.Consultas)
				{
					<tr>
						<td style="color:#4F6F52;font-weight:600;">@c.Codigo</td>
						<td>@c.Fecha.ToString("dd/MM/yyyy")</td>
						<td>@c.Motivo</td>
						<td>@(string.IsNullOrEmpty(c.Medico) ? "—" : c.Medico)</td>
						<td>@(string.IsNullOrEmpty(c.Diagnostico) ? "—" : (c.Diagnostico.Length > 60 ? c.Diagnostico[..60] + "…" : c.Diagnostico))</td>
						<td>
							@{
								var badgeColor = c.Estado switch {
									"completada" => "bg-success",
									"pendiente"  => "bg-warning text-dark",
									"cancelada"  => "bg-danger",
									_ => "bg-secondary"
								};
							}
							<span class="badge @badgeColor">@c.Estado</span>
						</td>
						<td class="text-end">
							<a asp-controller="Consultas" asp-action="Details" asp-route-id="@c.ConsultaId"
							   class="btn btn-sm btn-clinica">Ver</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}



