@model ClinicaMedEduardoMorenoMVCWeb.Models.Expedientes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Crear Expediente";
	ViewData["Seccion"] = "Expedientes";
}

<div class="mb-3">
	<h1>Crear Nuevo Expediente</h1>
	<a asp-action="Index" class="text-muted small">← Volver a la lista</a>
</div>

<hr />
<div class="row">
	<div class="col-md-6">
		<form asp-action="Create" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="form-group mb-3">
				<label asp-for="PacienteId" class="form-label"></label>
				<select asp-for="PacienteId" class="form-select" asp-items="ViewBag.PacienteId">
					<option value="">-- Seleccione un paciente --</option>
				</select>
				<span asp-validation-for="PacienteId" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Codigo" class="form-label"></label>
				<input asp-for="Codigo" class="form-control" placeholder="Ej. EXP-001" />
				<span asp-validation-for="Codigo" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Historial" class="form-label"></label>
				<textarea asp-for="Historial" class="form-control" rows="5" placeholder="Historial médico del paciente..."></textarea>
				<span asp-validation-for="Historial" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="FechaCreacion" class="form-label"></label>
				<input asp-for="FechaCreacion" type="date" class="form-control" />
				<span asp-validation-for="FechaCreacion" class="text-danger"></span>
			</div>

			<div class="form-group mt-4">
				<button type="submit" class="btn btn-primary">Guardar</button>
				<a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
