@using Microsoft.AspNetCore.Http
@model ClinicaMedEduardoMorenoMVCWeb.Models.Consultas

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Nueva Consulta";
    ViewData["Seccion"] = "Consultas Médicas";
    var rolSesion = Context.Session.GetString("UsuarioRol");
    var esEnfermera = (!string.IsNullOrEmpty(rolSesion) && rolSesion.Equals("Enfermera", StringComparison.OrdinalIgnoreCase))
                      || User.IsInRole("Enfermera")
                      || (ViewBag.EsEnfermera is bool b && b);
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card-clinica">
            <div class="card-clinica-header">
                <div>
                    <h2 class="card-clinica-titulo">Nueva Consulta @(esEnfermera ? "(Pre-clínica)" : "")</h2>
                    <div class="card-clinica-subtitulo">
                        @(esEnfermera ? "Toma de signos vitales y registro inicial para atención médica" : "Registre el motivo y los signos vitales del paciente")
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
            </div>

            @if (esEnfermera)
            {
                <div class="alert alert-info py-2 mb-3 small d-flex align-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                    </svg>
                    <span><strong>Acceso Enfermería:</strong> Ingrese los signos vitales y motivo de consulta. El diagnóstico y la prescripción de medicamentos serán agregados exclusivamente por el médico.</span>
                </div>
            }

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: var(--color-borde); font-size: 0.85rem; font-weight: 600;">Auto</span>
                        <input asp-for="Codigo" class="form-control bg-light" readonly style="cursor: not-allowed; font-weight: 600; color: var(--color-principal-oscuro);" />
                    </div>
                    <small class="text-muted d-block mt-1">El código se asigna automáticamente de forma correlativa.</small>
                </div>

                <partial name="_FormularioConsulta" model="Model" />

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary shadow-sm">Guardar Consulta</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
