@model ClinicaMedEduardoMorenoMVCWeb.Models.Medicamentos

@{
    ViewData["Title"] = "Detalles de Medicamento";
}

<h1>Detalles de Medicamento</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Codigo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.MedicamentoId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
