@model ClinicaMedEduardoMorenoMVCWeb.Models.Antecedentes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Editar Antecedente";
	ViewData["Seccion"] = "Expedientes Clínicos";
	var expedienteId = Model.ExpedienteId;
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 style="font-weight:700; color:#2F3E34; margin-bottom:0.15rem;">Editar Antecedente Médico</h4>
		@if (expedienteId.HasValue)
		{
			<a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "antecedentes" })"
			   style="color:#6B7280; font-size:0.9rem; text-decoration:none;">
				← Volver al expediente
			</a>
		}
	</div>
</div>

<hr style="margin: 0 0 1.5rem 0;" />

<div class="row">
	<div class="col-md-6">
		<div class="seccion-card">
			<form asp-action="Edit" method="post">
				@Html.AntiForgeryToken()
				<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

				<!-- Campos ocultos -->
				<input type="hidden" asp-for="AntecedentesId" />
				<input type="hidden" asp-for="ExpedienteId" />

				<div class="form-group mb-3">
					<label asp-for="Tipo" class="form-label">Tipo de Antecedente</label>
					<select asp-for="Tipo" class="form-select">
						<option value="">-- Seleccione un tipo --</option>
						<option value="Familiar">Familiar</option>
						<option value="Personal">Personal</option>
						<option value="Quirúrgico">Quirúrgico</option>
						<option value="Alérgico">Alérgico</option>
						<option value="Patológico">Patológico</option>
						<option value="Farmacológico">Farmacológico</option>
						<option value="Traumático">Traumático</option>
						<option value="Gineco-Obstétrico">Gineco-Obstétrico</option>
						<option value="Otro">Otro</option>
					</select>
					<span asp-validation-for="Tipo" class="text-danger small"></span>
				</div>

				<div class="form-group mb-3">
					<label asp-for="Descripcion" class="form-label">Descripción</label>
					<textarea asp-for="Descripcion" class="form-control" rows="4"
							  placeholder="Describa el antecedente médico..."></textarea>
					<span asp-validation-for="Descripcion" class="text-danger small"></span>
				</div>

				<div class="form-group mb-4">
					<label asp-for="Fecha" class="form-label">Fecha (opcional)</label>
					<input asp-for="Fecha" type="date" class="form-control" />
					<span asp-validation-for="Fecha" class="text-danger small"></span>
				</div>

				<div class="d-flex gap-2">
					<button type="submit" class="btn btn-clinica">Guardar Cambios</button>
					@if (expedienteId.HasValue)
					{
						<a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "antecedentes" })"
						   class="btn" style="border:1.5px solid #ccc; color:#374151; font-weight:600; border-radius:4px; padding:0.4rem 1.1rem;">
							Cancelar
						</a>
					}
					else
					{
						<a asp-action="Index" class="btn" style="border:1.5px solid #ccc; color:#374151; font-weight:600; border-radius:4px; padding:0.4rem 1.1rem;">
							Cancelar
						</a>
					}
				</div>
			</form>
		</div>
	</div>
</div>

<style>
	.seccion-card {
		background: #fff;
		border: 1px solid #e0e0e0;
		border-radius: 8px;
		padding: 1.5rem;
	}
	.btn-clinica {
		background: #4F6F52 !important;
		color: white !important;
		font-weight: 600;
		border-radius: 4px;
		padding: 0.4rem 1.1rem;
		border: none;
	}
	.btn-clinica:hover {
		background: #3A5240 !important;
		color: white !important;
	}
</style>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
