@model IEnumerable<ClinicaMedEduardoMorenoMVCWeb.Models.Antecedentes>

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Antecedentes Médicos";
	ViewData["Seccion"] = "Antecedentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h4 style="font-weight:700; color:#2F3E34; margin:0;">Antecedentes Médicos</h4>
	<a asp-action="Create" class="btn btn-clinica">+ Nuevo Antecedente</a>
</div>

<div class="tabla-wrap">
	<table class="tabla-interna">
		<thead>
			<tr>
				<th>Código</th>
				<th>Tipo</th>
				<th>Descripción</th>
				<th>Fecha</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr><td colspan="5" class="tabla-vacia">No hay antecedentes registrados.</td></tr>
			}
			@foreach (var item in Model)
			{
				<tr>
					<td style="color:#4F6F52; font-weight:600;">ANT-@item.AntecedentesId.ToString("D3")</td>
					<td>@item.Tipo</td>
					<td>@item.Descripcion</td>
					<td>@(item.Fecha?.ToString("dd/MM/yyyy") ?? "—")</td>
					<td class="text-end">
						@if (item.ExpedienteId.HasValue)
						{
							<a href="@Url.Action("Details", "Expedientes", new { id = item.ExpedienteId, tab = "antecedentes" })"
							   class="btn btn-sm btn-clinica me-1">Ver Expediente</a>
						}
						<a asp-action="Edit" asp-route-id="@item.AntecedentesId" class="btn btn-sm btn-clinica me-1">Editar</a>
						<a asp-action="Delete" asp-route-id="@item.AntecedentesId" class="btn btn-sm btn-peligro">Eliminar</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>


