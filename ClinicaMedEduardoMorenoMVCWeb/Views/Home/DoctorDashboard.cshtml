@model ClinicaMedEduardoMorenoMVCWeb.Models.ViewModels.DoctorDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Inicio - Clínica Médica";
    ViewData["Seccion"] = "Panel Principal";
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>


<body class="d-flex min-vh-100">
    <!--Barra Lateral Izquierda-->
    <aside class="sidebar-clinica d-flex flex-column">
        
        <!--Logo Clinica-->
        <div class="sidebar-header">
            <small>CLINICA MEDICA</small>
            <h3>Eduardo Moreno</h3>
        </div>

        <!--Menu Barras Laterales-->
        <nav class="sidebar-menu flex-grow-1">
            <a asp-controller="Expedientes" asp-action="Index">Expedientes Clinicos</a>
            <!-- Enlace a la pantalla que harán tus compañeras -->
            <a asp-controller="Consultas" asp-action="Index">Consultas Medicas</a>

            <div class="sidebar-section">CATALOGOS</div>
            <a asp-controller="Medicamentos" asp-action="Index">Medicamentos</a>
            <a asp-controller="Alergias" asp-action="Index">Alergias</a>
            <a asp-controller="Enfermedades" asp-action="Index">Enfermedades</a>
        </nav>

        <!--Cierre De Sesion-->
        <div class="sidebar-footer">
            <a asp-controller="Account" asp-action="Logout">Cerrar Sesion</a>
        </div>
    </aside>

    <!--Contenido de derecha-->
    <main class="contenido-principal flex-grow-1">

        <!--Barra Superior Verde con Datos Del Doctor-->
        <header class="header-doctor text-end">
            <!-- Título dinámico que muestra la sección actual -->
            <span class="fw-bold d-block">@(ViewData["Seccion"] ?? "Panel Principal")</span>
            <span class="d-block small">@(string.IsNullOrEmpty(Model?.NombreMedico) ? "Dr. Eduardo Moreno" : Model.NombreMedico) · Doctor</span>
        </header>

        <!-- Área de inicio en blanco -->
        <div class="p-4">
            
        </div>

    </main>

</body>
</html>
