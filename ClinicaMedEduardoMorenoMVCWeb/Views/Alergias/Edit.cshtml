@model ClinicaMedEduardoMorenoMVCWeb.Models.Alergias

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Editar Alergia";
    ViewData["Seccion"] = "Alergias";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card-clinica">
            <div class="card-clinica-header">
                <div>
                    <h2 class="card-clinica-titulo">Editar Alergia</h2>
                    <div class="card-clinica-subtitulo">Modifique la información de la alergia seleccionada</div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                <input type="hidden" asp-for="AlergiaId" />

                <div class="mb-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: var(--color-borde); font-size: 0.85rem; font-weight: 600;">Fijo</span>
                        <input asp-for="Codigo" class="form-control bg-light" readonly style="cursor: not-allowed; font-weight: 600; color: var(--color-principal-oscuro);" />
                    </div>
                    <small class="text-muted d-block mt-1">El código es un identificador fijo y no puede modificarse.</small>
                </div>

                <div class="mb-4">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary shadow-sm">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
