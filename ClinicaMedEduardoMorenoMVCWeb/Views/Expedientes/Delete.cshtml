@model ClinicaMedEduardoMorenoMVCWeb.Models.Expedientes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Eliminar Expediente";
	ViewData["Seccion"] = "Expedientes";
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 style="font-weight:700; color:#2F3E34; margin-bottom:0.15rem;">Eliminar Expediente Clínico</h4>
		<a asp-action="Index" style="color:#6B7280; font-size:0.9rem; text-decoration:none;">
			← Volver al listado
		</a>
	</div>
</div>

<hr style="margin: 0 0 1.5rem 0;" />

<div class="row">
	<div class="col-lg-8">
		<div class="alert alert-danger py-2 mb-3 small d-flex align-items-center" role="alert">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
				<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
			</svg>
			<span>¿Está seguro que desea eliminar este expediente clínico? Esta acción no se puede deshacer.</span>
		</div>

		<div class="seccion-card">
			<h5 class="seccion-titulo">Información del Expediente</h5>
			<dl class="row mb-0">
				<dt class="col-sm-4 campo-label">Código</dt>
				<dd class="col-sm-8" style="color:#4F6F52; font-weight:600;">@Model.Codigo</dd>

				<dt class="col-sm-4 campo-label">Paciente</dt>
				<dd class="col-sm-8 fw-semibold">@(Model.Paciente?.Nombre ?? Model.PacienteId.ToString())</dd>

				<dt class="col-sm-4 campo-label">Historial</dt>
				<dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Historial) ? "Sin historial registrado." : Model.Historial)</dd>

				<dt class="col-sm-4 campo-label">Fecha Creación</dt>
				<dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy")</dd>
			</dl>

			<form asp-action="Delete" method="post" class="mt-4 pt-3 border-top">
				@Html.AntiForgeryToken()
				<input type="hidden" asp-for="ExpedienteId" />
				<button type="submit" class="btn btn-peligro">Confirmar Eliminación</button>
				<a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
			</form>
		</div>
	</div>
</div>
