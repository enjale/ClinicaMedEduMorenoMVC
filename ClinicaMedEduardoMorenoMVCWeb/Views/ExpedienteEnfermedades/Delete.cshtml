@model ClinicaMedEduardoMorenoMVCWeb.Models.ExpedienteEnfermedades

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Eliminar Expediente de Enfermedad";
    ViewData["Seccion"] = "Expediente de Enfermedades";
}

<div class="mb-3">
    <h1>Eliminar Expediente de Enfermedad</h1>
    <a asp-action="Index" class="text-muted small">← Volver a la lista</a>
</div>

<hr />
<div class="alert alert-danger" role="alert">
    ¿Está seguro que desea eliminar este registro? Esta acción no se puede deshacer.
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Expediente</dt>
            <dd class="col-sm-8">@(Model.Expediente?.Codigo ?? Model.ExpedienteId.ToString())</dd>

            <dt class="col-sm-4">Enfermedad</dt>
            <dd class="col-sm-8">@(Model.Enfermedad?.Nombre ?? Model.EnfermedadId.ToString())</dd>

            <dt class="col-sm-4">Fecha Detección</dt>
            <dd class="col-sm-8">@(Model.FechaDeteccion?.ToString("dd/MM/yyyy") ?? "—")</dd>

            <dt class="col-sm-4">Observaciones</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Observaciones)</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ExpedienteEnfermedadId" />
            <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
