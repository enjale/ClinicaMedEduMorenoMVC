@model ClinicaMedEduardoMorenoMVCWeb.Models.RecetaDetalle

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Editar Detalle de Receta";
    ViewData["Seccion"] = "Detalles de Recetas";
}

<div class="mb-3">
    <h1>Editar Detalle de Receta</h1>
    <a asp-action="Index" class="text-muted small">← Volver a la lista</a>
</div>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="RecetaDetalleId" />

            <div class="form-group mb-3">
                <label asp-for="RecetaId" class="control-label"></label>
                <input asp-for="RecetaId" class="form-control" />
                <span asp-validation-for="RecetaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MedicamentoId" class="control-label"></label>
                <input asp-for="MedicamentoId" class="form-control" />
                <span asp-validation-for="MedicamentoId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Orden" class="control-label"></label>
                <input asp-for="Orden" class="form-control" min="1" />
                <span asp-validation-for="Orden" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescripcion" class="control-label"></label>
                <textarea asp-for="Prescripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Prescripcion" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
