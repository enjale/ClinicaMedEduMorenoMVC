@model ClinicaMedEduardoMorenoMVCWeb.Models.Enfermedades

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Crear Enfermedad";
    ViewData["Seccion"] = "Enfermedades";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card-clinica">
            <div class="card-clinica-header">
                <div>
                    <h2 class="card-clinica-titulo">Nueva Enfermedad</h2>
                    <div class="card-clinica-subtitulo">Ingrese los datos para registrar una enfermedad en el catálogo</div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted" style="border-color: var(--color-borde); font-size: 0.85rem; font-weight: 600;">Auto</span>
                        <input asp-for="Codigo" class="form-control bg-light" readonly style="cursor: not-allowed; font-weight: 600; color: var(--color-principal-oscuro);" />
                    </div>
                    <small class="text-muted d-block mt-1">El código se asigna automáticamente de forma correlativa.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Diabetes tipo 2, Hipertensión" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="TipoEnfermedad" class="form-label">Tipo de enfermedad</label>
                    <select asp-for="TipoEnfermedad" asp-items="@(new SelectList(ViewBag.TiposEnfermedad))" class="form-select">
                        <option value="">-- Seleccione un tipo --</option>
                    </select>
                    <span asp-validation-for="TipoEnfermedad" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary shadow-sm">Guardar Enfermedad</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
