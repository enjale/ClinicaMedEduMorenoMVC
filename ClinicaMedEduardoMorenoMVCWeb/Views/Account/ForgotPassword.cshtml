@model ClinicaMedEduardoMorenoMVCWeb.Models.ViewModels.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Recuperar Contraseña - Clínica Médica";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <!-- Panel Lateral Izquierdo -->
        <div class="login-lateral">
            <div class="login-subtitulo-clinica">CLÍNICA MÉDICA</div>
            <div class="login-nombre-clinica">Eduardo Moreno</div>
            <div class="login-linea-divisoria"></div>
            <p class="login-descripcion-sistema">Sistema de Gestión de Expedientes Médicos</p>
        </div>

        <!-- Panel Central/Derecho con Tarjeta -->
        <div class="login-derecho">
            <div class="login-tarjeta">
                <h2 class="login-titulo-formulario" style="font-size: 1.4rem; margin-bottom: 0.5rem;">Recuperar Contraseña</h2>
                <p class="text-muted small text-center mb-4">
                    Ingrese su correo electrónico o nombre de usuario y le enviaremos un enlace a su Gmail para restablecer su contraseña.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                    <div class="login-form-group">
                        <label asp-for="EmailOrUsername" class="login-label">Correo o Usuario</label>
                        <input asp-for="EmailOrUsername" class="login-input" placeholder="ejemplo@gmail.com o usuario" autofocus />
                        <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="login-boton-submit">
                        Enviar Enlace de Recuperación
                    </button>

                    <div class="text-center mt-3">
                        <a asp-action="Login" class="login-enlace-olvide" style="text-align: center; display: inline-block;">
                            ← Volver al Inicio de Sesión
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
