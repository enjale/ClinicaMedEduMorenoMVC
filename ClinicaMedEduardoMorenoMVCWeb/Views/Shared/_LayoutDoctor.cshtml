<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clínica Médica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex min-vh-100">

    <!--Barra Lateral Izquierda-->
    <aside class="sidebar-clinica d-flex flex-column">

        <!--Logo Clinica-->
        <div class="sidebar-header">
            <small>CLINICA MEDICA</small>
            <h3>Eduardo Moreno</h3>
        </div>

        <!--Menu Barras Laterales-->
        <nav class="sidebar-menu flex-grow-1">
            <a asp-controller="Expedientes" asp-action="Index">Expedientes Clinicos</a>
            <a asp-controller="Consultas" asp-action="Index">Consultas Medicas</a>

            <div class="sidebar-section">CATALOGOS</div>
            <a asp-controller="Medicamentos" asp-action="Index">Medicamentos</a>
            <a asp-controller="Alergias" asp-action="Index">Alergias</a>
            <a asp-controller="Enfermedades" asp-action="Index">Enfermedades</a>
        </nav>

        <!--Cierre De Sesion-->
        <div class="sidebar-footer">
            <a asp-controller="Account" asp-action="Login">Cerrar Sesion</a>
        </div>
    </aside>

    <!--Contenido de derecha-->
    <main class="contenido-principal flex-grow-1">

        <!--Barra Superior Verde con Datos Del Doctor-->
        <header class="header-doctor text-end">
            <span class="fw-bold d-block">@(ViewData["Seccion"] ?? ViewData["Title"] ?? "Panel Principal")</span>
            <span class="d-block small">Dr. Eduardo Moreno · Doctor</span>
        </header>

        <!-- Contenido de la vista -->
        <div class="p-4">
            @RenderBody()
        </div>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
