@model IEnumerable<ClinicaMedEduardoMorenoMVCWeb.Models.Expedientes>

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Expedientes Clínicos";
	ViewData["Seccion"] = "Expedientes Clínicos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2 class="mb-0" style="font-weight:700; color:#2F3E34;">Listado de Expedientes Clínicos</h2>
	<a asp-action="Create" class="btn" style="background:#4F6F52; color:white; font-weight:600; padding:0.5rem 1.2rem; border-radius:4px;">+ Nuevo Paciente</a>
</div>

<!-- Filtros de búsqueda -->
<form method="get" asp-action="Index">
	<div class="d-flex flex-wrap gap-3 align-items-end mb-4" style="background:#f8f9fa; padding:1rem; border-radius:6px; border:1px solid #e0e0e0;">
		<div>
			<label class="form-label small fw-semibold mb-1">Buscar</label>
			<input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" style="min-width:200px;" placeholder="Código o nombre..." />
		</div>
		<div>
			<label class="form-label small fw-semibold mb-1">Sexo</label>
			<select name="sexo" class="form-select" style="min-width:110px;">
				<option value="Todos" selected="@(ViewBag.Sexo == "Todos")">Todos</option>
				<option value="M" selected="@(ViewBag.Sexo == "M")">Masculino</option>
				<option value="F" selected="@(ViewBag.Sexo == "F")">Femenino</option>
			</select>
		</div>
		<div>
			<label class="form-label small fw-semibold mb-1">Creado desde</label>
			<input type="date" name="creadoDesde" value="@ViewBag.CreadoDesde" class="form-control" />
		</div>
		<div>
			<label class="form-label small fw-semibold mb-1">Creado hasta</label>
			<input type="date" name="creadoHasta" value="@ViewBag.CreadoHasta" class="form-control" />
		</div>
		<div class="d-flex gap-2">
			<button type="submit" class="btn" style="background:#4F6F52; color:white; font-weight:600; padding:0.5rem 1.2rem; border-radius:4px;">Buscar</button>
			<a asp-action="Index" class="btn" style="background:transparent; color:#4F6F52; border:1.5px solid #4F6F52; font-weight:600; padding:0.5rem 1.2rem; border-radius:4px;">Limpiar</a>
		</div>
	</div>
</form>

<!-- Tabla de resultados -->
<div style="border:1px solid #e0e0e0; border-radius:6px; overflow:hidden;">
	<table class="table table-hover mb-0">
		<thead style="background:#4F6F52; color:white;">
			<tr>
				<th style="font-weight:600; padding:0.85rem 1rem; color:white;">Código</th>
				<th style="font-weight:600; padding:0.85rem 1rem; color:white;">Paciente</th>
				<th style="font-weight:600; padding:0.85rem 1rem; color:white;">Sexo</th>
				<th style="font-weight:600; padding:0.85rem 1rem; color:white;">F. Nacimiento</th>
				<th style="font-weight:600; padding:0.85rem 1rem; color:white;">F. Creación</th>
				<th style="font-weight:600; padding:0.85rem 1rem; color:white;">Acciones</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="6" class="text-center py-4 text-muted">No se encontraron expedientes.</td>
				</tr>
			}
			@foreach (var item in Model)
			{
				<tr style="transition: background 0.15s;">
					<td style="padding:0.75rem 1rem; color:#4F6F52; font-weight:600;">@item.Codigo</td>
					<td style="padding:0.75rem 1rem;">@(item.Paciente?.Nombre ?? "—")</td>
					<td style="padding:0.75rem 1rem;">@(item.Paciente?.Sexo ?? "—")</td>
					<td style="padding:0.75rem 1rem;">@(item.Paciente?.FechaNac?.ToString("dd/MM/yyyy") ?? "—")</td>
					<td style="padding:0.75rem 1rem;">@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
					<td style="padding:0.75rem 1rem;">
						<a asp-action="Details" asp-route-id="@item.ExpedienteId" asp-route-tab="alergias"
						   class="btn btn-sm" style="background:#4F6F52; color:white; font-weight:600; padding:0.35rem 1rem; border-radius:4px;">
							Ver Expediente
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="mt-3 text-muted small">
	@Model.Count() expediente(s) encontrado(s)
</div>
