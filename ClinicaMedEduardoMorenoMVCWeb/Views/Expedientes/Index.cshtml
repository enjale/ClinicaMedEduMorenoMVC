@model IEnumerable<ClinicaMedEduardoMorenoMVCWeb.Models.Expedientes>

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Expedientes Clínicos";
	ViewData["Seccion"] = "Expedientes Clínicos";
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-center mb-3">
	<div>
		<h4 style="font-weight:700; color:#2F3E34; margin:0;">Listado de Expedientes Clínicos</h4>
		<small class="text-muted">Registro y administración de expedientes de pacientes</small>
	</div>
	<a asp-action="Create" class="btn btn-clinica">+ Nuevo Expediente</a>
</div>

@if (TempData["Mensaje"] is string msg)
{
	<div class="alert alert-success alert-dismissible fade show py-2 mb-3" role="alert">
		@msg
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
	</div>
}
@if (TempData["Error"] is string err)
{
	<div class="alert alert-warning alert-dismissible fade show py-2 mb-3 d-flex align-items-center" role="alert">
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="me-2 flex-shrink-0" viewBox="0 0 16 16">
			<path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
		</svg>
		<span>@err</span>
		<button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
	</div>
}

<!-- Filtros de búsqueda -->
<form method="get" asp-action="Index">
	<div class="seccion-card mb-4 p-3">
		<div class="row g-2 align-items-end">
			<div class="col-md-3">
				<label class="form-label small fw-semibold mb-1">Buscar</label>
				<input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control form-control-sm" placeholder="Código o nombre de paciente..." />
			</div>
			<div class="col-md-2">
				<label class="form-label small fw-semibold mb-1">Sexo</label>
				<select name="sexo" class="form-select form-select-sm">
					<option value="Todos" selected="@(ViewBag.Sexo == "Todos")">Todos</option>
					<option value="M" selected="@(ViewBag.Sexo == "M")">Masculino</option>
					<option value="F" selected="@(ViewBag.Sexo == "F")">Femenino</option>
				</select>
			</div>
			<div class="col-md-2">
				<label class="form-label small fw-semibold mb-1">Creado desde</label>
				<input type="date" name="creadoDesde" value="@ViewBag.CreadoDesde" class="form-control form-control-sm" />
			</div>
			<div class="col-md-2">
				<label class="form-label small fw-semibold mb-1">Creado hasta</label>
				<input type="date" name="creadoHasta" value="@ViewBag.CreadoHasta" class="form-control form-control-sm" />
			</div>
			<div class="col-md-3 d-flex gap-2">
				<button type="submit" class="btn btn-sm btn-clinica flex-grow-1">Buscar</button>
				<a asp-action="Index" class="btn btn-sm btn-outline-secondary">Limpiar</a>
			</div>
		</div>
	</div>
</form>

<!-- Tabla de resultados -->
<div class="tabla-wrap">
	<table class="tabla-interna">
		<thead>
			<tr>
				<th>Código</th>
				<th>Paciente</th>
				<th>Sexo</th>
				<th>F. Nacimiento</th>
				<th>F. Creación</th>
				<th class="text-end">Acciones</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="6" class="tabla-vacia">No se encontraron expedientes.</td>
				</tr>
			}
			@foreach (var item in Model)
			{
				<tr>
					<td style="color:#4F6F52; font-weight:600;">@item.Codigo</td>
					<td style="font-weight:600;">@(item.Paciente?.Nombre ?? "—")</td>
					<td>
						@if (item.Paciente?.Sexo == "M")
						{
							<span class="badge bg-light text-dark border">Masculino</span>
						}
						else if (item.Paciente?.Sexo == "F")
						{
							<span class="badge bg-light text-dark border">Femenino</span>
						}
						else
						{
							<span>@(item.Paciente?.Sexo ?? "—")</span>
						}
					</td>
					<td>@(item.Paciente?.FechaNac?.ToString("dd/MM/yyyy") ?? "—")</td>
					<td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
					<td class="text-end">
						<a asp-action="Details" asp-route-id="@item.ExpedienteId" asp-route-tab="alergias"
						   class="btn btn-sm btn-clinica me-1">
							Ver Expediente
						</a>
						<a asp-action="Edit" asp-route-id="@item.ExpedienteId"
						   class="btn btn-sm btn-outline-secondary">
							Editar
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="mt-3 text-muted small">
	@Model.Count() expediente(s) encontrado(s)
</div>
