@model ClinicaMedEduardoMorenoMVCWeb.Models.ExpedienteEnfermedades

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Detalle de Enfermedad";
    ViewData["Seccion"] = "Expedientes Clínicos";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="seccion-h4 mb-1">Detalle de Enfermedad en Expediente</h4>
        <a href="@Url.Action("Details", "Expedientes", new { id = Model.ExpedienteId, tab = "alergias" })"
           class="text-muted small">
            ← Volver al expediente
        </a>
    </div>
</div>

<hr class="mb-4" />

<div class="row">
    <div class="col-md-6">
        <div class="seccion-card">
            <h5 class="seccion-titulo">Información de la Enfermedad</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4 campo-label">Expediente</dt>
                <dd class="col-sm-8">@(Model.Expediente?.Codigo ?? Model.ExpedienteId.ToString())</dd>

                <dt class="col-sm-4 campo-label">Enfermedad</dt>
                <dd class="col-sm-8 fw-semibold" style="color:#2F3E34;">@(Model.Enfermedad?.Nombre ?? Model.EnfermedadId.ToString())</dd>

                <dt class="col-sm-4 campo-label">Fecha Detección</dt>
                <dd class="col-sm-8">@(Model.FechaDeteccion?.ToString("dd/MM/yyyy") ?? "—")</dd>

                <dt class="col-sm-4 campo-label">Observaciones</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Observaciones) ? "—" : Model.Observaciones)</dd>
            </dl>
        </div>

        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.ExpedienteEnfermedadId" class="btn btn-clinica">
                Editar
            </a>
            <a href="@Url.Action("Details", "Expedientes", new { id = Model.ExpedienteId, tab = "alergias" })"
               class="btn btn-outline-secondary">
                Volver al Expediente
            </a>
        </div>
    </div>
</div>