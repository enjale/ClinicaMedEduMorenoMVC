@model ClinicaMedEduardoMorenoMVCWeb.Models.Antecedentes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Detalles del Antecedente";
	ViewData["Seccion"] = "Antecedentes";
}

<h1>Detalles del Antecedente</h1>

<div class="card">
	<div class="card-body">
		<div class="mb-3">
			<label class="form-label"><strong>Tipo:</strong></label>
			<p>@Html.DisplayFor(model => model.Tipo)</p>
		</div>

		<div class="mb-3">
			<label class="form-label"><strong>Descripción:</strong></label>
			<p>@Html.DisplayFor(model => model.Descripcion)</p>
		</div>

		<div class="mb-3">
			<label class="form-label"><strong>Fecha:</strong></label>
			<p>@(Model.Fecha?.ToString("dd/MM/yyyy") ?? "N/A")</p>
		</div>
	</div>
</div>

<div class="mt-3">
	<a asp-action="Edit" asp-route-id="@Model.AntecedentesId" class="btn btn-primary">Editar</a>
	<a asp-action="Delete" asp-route-id="@Model.AntecedentesId" class="btn btn-danger">Eliminar</a>
	<a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
