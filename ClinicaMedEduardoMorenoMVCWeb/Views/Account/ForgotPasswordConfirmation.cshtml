@{
    Layout = null;
    ViewData["Title"] = "Enlace Enviado - Clínica Médica";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <!-- Panel Lateral Izquierdo -->
        <div class="login-lateral">
            <div class="login-subtitulo-clinica">CLÍNICA MÉDICA</div>
            <div class="login-nombre-clinica">Eduardo Moreno</div>
            <div class="login-linea-divisoria"></div>
            <p class="login-descripcion-sistema">Sistema de Gestión de Expedientes Médicos</p>
        </div>

        <!-- Panel Central/Derecho con Tarjeta -->
        <div class="login-derecho">
            <div class="login-tarjeta text-center">
                <div style="font-size: 3rem; color: var(--color-secundario); margin-bottom: 1rem;">
                    ✉️
                </div>
                <h2 class="login-titulo-formulario" style="font-size: 1.4rem; margin-bottom: 0.75rem;">¡Revisa tu Correo!</h2>
                <p class="text-muted small mb-4" style="line-height: 1.6;">
                    Si el correo o usuario coincide con una cuenta registrada, hemos enviado las instrucciones y el enlace para restablecer tu contraseña.
                </p>

                <div class="alert alert-light border small text-muted text-start mb-4">
                    💡 <strong>Tip:</strong> Revisa también tu carpeta de <em>Spam</em> o <em>Correo no deseado</em> si no lo encuentras en tu bandeja de entrada principal.
                </div>

                <a asp-action="Login" class="login-boton-submit d-block text-center text-decoration-none" style="padding-top: 0.75rem; padding-bottom: 0.75rem;">
                    Volver al Inicio de Sesión
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
