@model IEnumerable<ClinicaMedEduardoMorenoMVCWeb.Models.Pacientes>

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Pacientes";
    ViewData["Seccion"] = "Pacientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 style="font-weight:700; color:#2F3E34; margin:0;">Listado de Pacientes</h4>
        <small class="text-muted">Registro y administración de información de pacientes</small>
    </div>
    <a asp-action="Create" class="btn btn-clinica">+ Nuevo Paciente</a>
</div>

<div class="tabla-wrap">
    <table class="tabla-interna">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Sexo</th>
                <th>F. Nacimiento</th>
                <th>DUI</th>
                <th>Teléfono</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="tabla-vacia">No hay pacientes registrados.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:#4F6F52; font-weight:600;">@item.Codigo</td>
                    <td style="font-weight:600;">@item.Nombre</td>
                    <td>
                        @if (item.Sexo == "M")
                        {
                            <span class="badge bg-light text-dark border">Masculino</span>
                        }
                        else if (item.Sexo == "F")
                        {
                            <span class="badge bg-light text-dark border">Femenino</span>
                        }
                        else
                        {
                            <span>@item.Sexo</span>
                        }
                    </td>
                    <td>@(item.FechaNac?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>@(string.IsNullOrEmpty(item.DUI) ? "—" : item.DUI)</td>
                    <td>@(string.IsNullOrEmpty(item.Telefono) ? "—" : item.Telefono)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-pacienteid="@item.PacienteId" class="btn btn-sm btn-clinica me-1">Detalles</a>
                        <a asp-action="Edit" asp-route-pacienteid="@item.PacienteId" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                        <a asp-action="Delete" asp-route-pacienteid="@item.PacienteId" class="btn btn-sm btn-peligro">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3 text-muted small">
    @Model.Count() paciente(s) registrado(s)
</div>
