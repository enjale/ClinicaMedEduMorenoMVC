@model IEnumerable<ClinicaMedEduardoMorenoMVCWeb.Models.ExpedienteAlergias>

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Alergias en Expedientes";
	ViewData["Seccion"] = "Alergias en Expedientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2 class="mb-0" style="font-weight:700; color:#2F3E34;">Alergias Registradas</h2>
	<a asp-action="Create" class="btn btn-clinica">+ Agregar Alergia</a>
</div>

<div class="tabla-wrap">
	<table class="tabla-interna">
		<thead>
			<tr>
				<th>Expediente</th>
				<th>Alergia</th>
				<th>Nivel</th>
				<th>Observaciones</th>
				<th class="text-end">Acciones</th>
			</tr>
		</thead>
		<tbody>
			@if (!Model.Any())
			{
				<tr>
					<td colspan="5" class="tabla-vacia">No hay alergias registradas.</td>
				</tr>
			}
			@foreach (var item in Model)
			{
				<tr>
					<td style="color:#4F6F52; font-weight:600;">
						@(item.Expediente?.Codigo ?? item.ExpedienteId.ToString())
					</td>
					<td style="font-weight:600; color:#2F3E34;">@(item.Alergia?.Nombre ?? item.AlergiaId.ToString())</td>
					<td>
						@{
							var badgeClass = item.Nivel switch
							{
								"Leve" => "bg-success",
								"Moderado" => "bg-warning text-dark",
								"Severo" => "bg-danger",
								"Muy Severo" => "bg-danger",
								_ => "bg-secondary"
							};
						}
						<span class="badge @badgeClass">
							@item.Nivel
						</span>
					</td>
					<td class="text-muted">
						@(string.IsNullOrEmpty(item.Observaciones) ? "—" : item.Observaciones)
					</td>
					<td class="text-end">
						<a asp-action="Details" asp-route-id="@item.ExpedienteAlergiaId"
						   class="btn btn-sm btn-outline-secondary me-1">
							Ver
						</a>
						<a asp-action="Edit" asp-route-id="@item.ExpedienteAlergiaId"
						   class="btn btn-sm btn-clinica me-1">
							Editar
						</a>
						<a asp-action="Delete" asp-route-id="@item.ExpedienteAlergiaId"
						   class="btn btn-sm btn-peligro">
							Eliminar
						</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="mt-3 text-muted small">
	@Model.Count() alergia(s) encontrada(s)
</div>
