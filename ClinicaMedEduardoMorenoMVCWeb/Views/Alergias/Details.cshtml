@model ClinicaMedEduardoMorenoMVCWeb.Models.Alergias

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Detalles de Alergia";
    ViewData["Seccion"] = "Alergias";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card-clinica">
            <div class="card-clinica-header">
                <div>
                    <h2 class="card-clinica-titulo">Detalles de la Alergia</h2>
                    <div class="card-clinica-subtitulo">Información registrada en el sistema</div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
            </div>

            <div class="bg-light p-3 rounded mb-4 border">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted fw-bold">@Html.DisplayNameFor(model => model.Codigo):</div>
                    <div class="col-sm-8"><span class="badge-codigo">@Model.Codigo</span></div>
                </div>
                <div class="row">
                    <div class="col-sm-4 text-muted fw-bold">@Html.DisplayNameFor(model => model.Nombre):</div>
                    <div class="col-sm-8 fw-semibold">@Model.Nombre</div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
                <a asp-action="Edit" asp-route-id="@Model.AlergiaId" class="btn btn-primary shadow-sm">Editar Alergia</a>
            </div>
        </div>
    </div>
</div>
