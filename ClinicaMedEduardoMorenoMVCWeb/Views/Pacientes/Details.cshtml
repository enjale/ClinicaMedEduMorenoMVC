@model ClinicaMedEduardoMorenoMVCWeb.Models.Pacientes

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Detalles del Paciente";
    ViewData["Seccion"] = "Pacientes";
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 style="font-weight:700; color:#2F3E34; margin-bottom:0.15rem;">Detalles del Paciente</h4>
        <a asp-action="Index" style="color:#6B7280; font-size:0.9rem; text-decoration:none;">
            ← Volver al listado
        </a>
    </div>
    <div>
        <a asp-action="Edit" asp-route-pacienteid="@Model?.PacienteId" class="btn btn-clinica me-1">Editar Paciente</a>
        <a asp-action="Delete" asp-route-pacienteid="@Model?.PacienteId" class="btn btn-peligro">Eliminar</a>
    </div>
</div>

<hr style="margin: 0 0 1.5rem 0;" />

<div class="row">
    <div class="col-lg-8">
        <div class="seccion-card">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="me-3" style="width: 48px; height: 48px; border-radius: 50%; background-color: #E7ECE8; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #4F6F52; font-size: 1.2rem;">
                    @(Model?.Nombre?.Substring(0, 1).ToUpper() ?? "P")
                </div>
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #2F3E34;">@Model?.Nombre</h5>
                    <span class="text-muted small">Código: <strong style="color: #4F6F52;">@Model?.Codigo</strong></span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="text-muted small d-block">Sexo</label>
                    <span class="fw-semibold">
                        @if (Model?.Sexo == "M")
                        {
                            <span class="badge bg-light text-dark border">Masculino</span>
                        }
                        else if (Model?.Sexo == "F")
                        {
                            <span class="badge bg-light text-dark border">Femenino</span>
                        }
                        else
                        {
                            <span>@(Model?.Sexo ?? "—")</span>
                        }
                    </span>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small d-block">Fecha de Nacimiento</label>
                    <span class="fw-semibold">@(Model?.FechaNac?.ToString("dd/MM/yyyy") ?? "—")</span>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small d-block">DUI</label>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(Model?.DUI) ? "—" : Model.DUI)</span>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small d-block">Teléfono</label>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(Model?.Telefono) ? "—" : Model.Telefono)</span>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small d-block">Altura (m)</label>
                    <span class="fw-semibold">@(Model?.Altura.HasValue == true ? $"{Model.Altura.Value:0.00} m" : "—")</span>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small d-block">Peso</label>
                    <span class="fw-semibold">@(Model?.Peso.HasValue == true ? $"{Model.Peso.Value:0.00}" : "—")</span>
                </div>

                <div class="col-12">
                    <label class="text-muted small d-block">Dirección</label>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(Model?.Direccion) ? "—" : Model.Direccion)</span>
                </div>

                <div class="col-sm-6">
                    <label class="text-muted small d-block">Fecha de Registro</label>
                    <span class="fw-semibold">@Model?.CreadoEn.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
        </div>
    </div>
</div>
