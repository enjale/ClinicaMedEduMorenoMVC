@model ClinicaMedEduardoMorenoMVCWeb.Models.Antecedentes

@{
	Layout = "_LayoutDoctor";
	ViewData["Title"] = "Eliminar Antecedente";
	ViewData["Seccion"] = "Expedientes Clínicos";
}

<div class="d-flex justify-content-between align-items-start mb-3">
	<div>
		<h4 class="seccion-h4 mb-1">Eliminar Antecedente Médico</h4>
		<a asp-action="Index" class="text-muted small">← Volver a la lista</a>
	</div>
</div>

<hr class="mb-4" />

<div class="alert alert-danger" role="alert" style="max-width: 600px;">
	¿Está seguro que desea eliminar este antecedente? Esta acción no se puede deshacer.
</div>

<div class="row">
	<div class="col-md-6">
		<div class="seccion-card">
			<dl class="row mb-0">
				<dt class="col-sm-4 campo-label">Tipo</dt>
				<dd class="col-sm-8">@Html.DisplayFor(model => model.Tipo)</dd>

				<dt class="col-sm-4 campo-label">Descripción</dt>
				<dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

				<dt class="col-sm-4 campo-label">Fecha</dt>
				<dd class="col-sm-8">@(Model.Fecha?.ToString("dd/MM/yyyy") ?? "—")</dd>
			</dl>
		</div>

		<form asp-action="Delete" method="post" class="mt-3">
			@Html.AntiForgeryToken()
			<input type="hidden" asp-for="AntecedentesId" />
			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-peligro">Confirmar Eliminación</button>
				<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
			</div>
		</form>
	</div>
</div>
