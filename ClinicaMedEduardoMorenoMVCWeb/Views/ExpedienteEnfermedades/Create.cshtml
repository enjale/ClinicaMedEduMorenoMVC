@model ClinicaMedEduardoMorenoMVCWeb.Models.ExpedienteEnfermedades

@{
    Layout = "_LayoutDoctor";
    ViewData["Title"] = "Agregar Enfermedad";
    ViewData["Seccion"] = "Expedientes Clínicos";
    var expedienteId = ViewBag.ExpedienteIdActual as int?;
}

<!-- Encabezado -->
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="seccion-h4 mb-1">Agregar Enfermedad Crónica al Expediente</h4>
        @if (expedienteId.HasValue)
        {
            <a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "alergias" })"
               class="text-muted small">
                ← Volver al expediente
            </a>
        }
    </div>
</div>

<hr class="mb-4" />

<div class="row">
    <div class="col-md-6">
        <div class="seccion-card">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label class="form-label">Expediente</label>
                    <select asp-for="ExpedienteId" class="form-select" asp-items="ViewBag.ExpedienteId">
                        <option value="">-- Seleccione un expediente --</option>
                    </select>
                    <span asp-validation-for="ExpedienteId" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EnfermedadId" class="form-label">Enfermedad</label>
                    <select asp-for="EnfermedadId" class="form-select" asp-items="ViewBag.EnfermedadId">
                        <option value="">-- Seleccione una enfermedad --</option>
                    </select>
                    <span asp-validation-for="EnfermedadId" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="FechaDeteccion" class="form-label">Fecha de Detección</label>
                    <input asp-for="FechaDeteccion" type="date" class="form-control" />
                    <span asp-validation-for="FechaDeteccion" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Observaciones" class="form-label">Observaciones (opcional)</label>
                    <textarea asp-for="Observaciones" class="form-control" rows="3"
                              placeholder="Síntomas, tratamiento actual, notas relevantes..."></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-clinica">Guardar Enfermedad</button>
                    @if (expedienteId.HasValue)
                    {
                        <a href="@Url.Action("Details", "Expedientes", new { id = expedienteId, tab = "alergias" })"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
