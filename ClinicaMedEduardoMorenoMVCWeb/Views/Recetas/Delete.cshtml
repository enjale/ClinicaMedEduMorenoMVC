@model ClinicaMedEduardoMorenoMVCWeb.Models.Recetas

@{
    ViewData["Title"] = "Eliminar Receta";
}

<h1>Eliminar Receta</h1>

<h3>¿Estás seguro de que deseas eliminar esta receta?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Codigo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Codigo)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ConsultaId)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ConsultaId)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Fecha)</dt>
        <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Medico)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Medico)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="RecetaId" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
